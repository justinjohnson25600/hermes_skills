+# --- round 4 (GLM-5.3 review of the council change) ---------------------------------
+
+def test_strict_retry_that_raises_keeps_attempt_one(council_home, monkeypatch):
+    _write_config(council_home, protocol="strict")
+    calls: list[dict] = []
+    per: dict[str, int] = {}
+
+    def fake(**kw):
+        calls.append(kw)
+        task, model = kw.get("task"), str(kw.get("model") or "")
+        if task == "council_member":
+            return _response(f"answer by {model}")
+        if task == "council_review":
+            per[model] = per.get(model, 0) + 1
+            if per[model] == 1:
+                return _response("MATERIAL FLAW: Response A drops writes on crash — blocks ship.\nno ranking")
+            raise RuntimeError("network gone")
+        return _response("chairman")
+
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", fake)
+    facade = _facade()
+    guidance = facade.prepare(messages=[{"role": "user", "content": "q"}])["guidance"]
+    state = facade._council_cache_state
+    assert state["summary"]["stage2_calls"] == 6, "3 seats x (attempt + failed retry) — all counted"
+    assert "drops writes on crash" in guidance, "attempt 1's material flaw must survive a failed retry"
+    assert sum("corrective retry failed" in f for f in state["failures"]) == 3
+    assert all(r.get("calls") == 2 for r in state["receipts"] if r["stage"] == "council_review")
+
+
+@pytest.mark.parametrize("line", [
+    "**MATERIAL FLAW:** Response B leaks a token — blocks release",
+    "1. MATERIAL FLAW: Response B leaks a token — blocks release",
+    "> MATERIAL FLAW: Response B leaks a token — blocks release",
+    "- **MATERIAL FLAW**: Response B leaks a token — blocks release",
+])
+def test_material_flaw_lines_as_models_write_them(line):
+    from hermes_council.council_loop import material_flaws
+    got = material_flaws("Review prose.\n" + line + "\nFINAL RANKING:\n1. Response A")
+    assert got and "leaks a token" in got[0]
+
+
+def test_egress_redacts_nested_tool_results_and_arguments():
+    from hermes_council.council_loop import _egress_messages
+    msgs = [
+        {"role": "assistant", "content": None, "tool_calls": [
+            {"id": "call_1", "type": "function",
+             "function": {"name": "terminal", "arguments": f'{{"cmd": "export K={SECRET}"}}'}}]},
+        {"role": "tool", "tool_call_id": "call_1", "content": f"K={SECRET}"},
+        {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "t1",
+                                      "content": [{"type": "text", "text": f"token {SECRET}"}]}]},
+    ]
+    out = _egress_messages(msgs)
+    import json as _json
+    assert SECRET not in _json.dumps(out)
+    assert out[0]["tool_calls"][0]["id"] == "call_1" and out[1]["tool_call_id"] == "call_1"
+    assert out[2]["content"][0]["tool_use_id"] == "t1"
+    assert SECRET in _json.dumps(msgs), "the caller's transcript is not mutated"
+
+
+def test_strict_budget_boundary_and_lite(council_home, monkeypatch):
+    _write_config(council_home, protocol="strict", max_calls=10)  # 3 + 3*2 + 1 == 10
+    _install(monkeypatch)
+    facade = _facade()
+    facade.prepare(messages=[{"role": "user", "content": "q"}])
+    assert facade._council_cache_state["protocol"] == "strict"
+    from hermes_council.council_loop import _as_budget
+    assert _as_budget(True) == 0 and _as_budget("7") == 7 and _as_budget("x") == 0 and _as_budget(-2) == 0
+
+
+def test_strict_with_two_answers_skips_peer_review(council_home, monkeypatch):
+    _write_config(council_home, protocol="strict", members=2)
+    calls = _install(monkeypatch)
+    facade = _facade()
+    guidance = facade.prepare(messages=[{"role": "user", "content": "q"}])["guidance"]
+    assert [c["task"] for c in calls].count("council_review") == 0
+    assert "strict peer review skipped: needs at least 3 answers without a judge" in guidance
