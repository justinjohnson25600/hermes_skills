+def _labels_in(text):
+    return sorted(set(re.findall(r"=== (Response [A-Z]+) ===", text)))
+
+
+def _good_review(labels):
+    body = "MATERIAL FLAW: Response A ignores rollback — changes go/no-go.\nFINAL RANKING:\n"
+    return body + "\n".join(f"{i}. {lab}" for i, lab in enumerate(labels, start=1))
+
+
+def _install(monkeypatch, *, review=None):
+    """review(call_index_for_this_reviewer, prompt_text, labels) -> reply text."""
+    calls: list[dict] = []
+    per_reviewer: dict[str, int] = {}
+
+    def fake(**kw):
+        calls.append(kw)
+        task = kw.get("task")
+        model = str(kw.get("model") or "")
+        text = "\n".join(str(m.get("content")) for m in kw.get("messages") or [])
+        if task == "council_member":
+            return _response(f"answer by {model}")
+        if task in ("council_review", "council_judge"):
+            n = per_reviewer[model] = per_reviewer.get(model, 0) + 1
+            labels = _labels_in(text)
+            return _response(review(n, text, labels) if review else _good_review(labels))
+        return _response("chairman acted")
+
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", fake)
+    return calls
+
+
+def _facade():
+    from hermes_council.council_loop import CouncilChatCompletions
+    return CouncilChatCompletions("default")
+
+
+def _all_text(call):
+    return "\n".join(str(m.get("content")) for m in call.get("messages") or [])
