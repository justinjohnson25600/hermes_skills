+def _write_config(home, *, members=3, protocol=None, judge=None, max_calls=None):
+    judge = judge or {"provider": "", "model": ""}
+    member_lines = "\n".join(
+        f"        - provider: openrouter\n          model: member-{i}\n          enabled: true"
+        for i in range(1, members + 1)
+    )
+    extra = ""
+    if protocol:
+        extra += f"      protocol: {protocol}\n"
+    if max_calls is not None:
+        extra += f"      max_calls: {max_calls}\n"
+    (home / "config.yaml").write_text(
+        "council:\n  default_preset: default\n  presets:\n    default:\n      members:\n"
+        f"{member_lines}\n"
+        "      judge:\n"
+        f"        provider: \"{judge.get('provider', '')}\"\n"
+        f"        model: \"{judge.get('model', '')}\"\n"
+        "        enabled: true\n"
+        "      chairman:\n        provider: openrouter\n        model: chairman-model\n"
+        "      lite: false\n      enabled: true\n" + extra,
+        encoding="utf-8",
+    )
