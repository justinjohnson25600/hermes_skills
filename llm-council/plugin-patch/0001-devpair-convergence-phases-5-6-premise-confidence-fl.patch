+def _run_strict_reviewer(slot: dict[str, Any], task: str, review_messages: list[dict[str, Any]],
+                         labels: list[str], **opts: Any) -> dict[str, Any]:
+    """Strict-protocol review: a valid complete ranking AND a stakes statement are
+    required. One corrective retry; a second invalid answer is DISCARDED (counted
+    as a failure by the caller), never parsed leniently."""
+    text, acct, reported = _run_reviewer(slot, task, review_messages, **opts)
+    accts, calls = [acct], 1
+    ranking = parse_ranking_strict(text, labels)
+    if ranking is None or not _stakes_stated(text):
+        fix = (
+            "Your reply was not valid for this council. Reply again with BOTH: (1) one "
+            "'MATERIAL FLAW:' line per material flaw, or 'No material flaws found.'; and "
+            "(2) a FINAL RANKING block listing each of these exactly once: "
+            + ", ".join(labels) + ".\n\n" + RANKING_INSTRUCTIONS
+        )
+        retry = list(review_messages) + [{"role": "assistant", "content": text},
+                                         {"role": "user", "content": fix}]
+        text, acct, reported = _run_reviewer(slot, task, retry, **opts)
+        accts.append(acct)
+        calls += 1
+        ranking = parse_ranking_strict(text, labels)
+        if ranking is not None and not _stakes_stated(text):
+            ranking = None
+    return {"text": text, "accountings": accts, "ranking": ranking, "reported": reported, "calls": calls}
 
 
