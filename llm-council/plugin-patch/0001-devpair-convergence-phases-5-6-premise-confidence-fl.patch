+def parse_ranking_strict(text: Any, labels: list[str]) -> list[str] | None:
+    """Strict-protocol ranking: the LAST ``FINAL RANKING:`` block must list every
+    presented label exactly once as ``N. Response X`` lines — no bare-mention
+    fallback, no partial or padded rankings. None when invalid."""
+    if not isinstance(text, str):
+        return None
+    marker = text.upper().rfind("FINAL RANKING:")
+    if marker < 0:
+        return None
+    got: list[str] = []
+    for line in text[marker:].splitlines()[1:]:
+        if not line.strip():
+            continue
+        match = _RANK_LINE_RE.match(line)
+        if not match:
+            break
+        got.append(f"Response {match.group(1).upper()}")
+    return got if sorted(got) == sorted(labels) and len(set(got)) == len(got) else None
+
+
+_MATERIAL_FLAW_RE = re.compile(r"^\s*[-*]?\s*MATERIAL FLAW:\s*(.+)$", re.IGNORECASE | re.MULTILINE)
+_NO_FLAWS_RE = re.compile(r"no material flaws found", re.IGNORECASE)
+
+
+def material_flaws(text: Any) -> list[str]:
+    return [m.group(1).strip() for m in _MATERIAL_FLAW_RE.finditer(text or "")]
+
+
+def _stakes_stated(text: Any) -> bool:
+    return bool(material_flaws(text)) or bool(_NO_FLAWS_RE.search(text or ""))
+
+
+def aggregate_first_place(rankings: list[list[str]], all_labels: list[str]) -> list[tuple[str, float, int]]:
+    """Strict aggregation: first-place votes FIRST, average rank only as the
+    tie-break. Each label is averaged over the reviewers that were SHOWN it, so
+    excluding a member's own answer from its review never penalises it."""
+    if not all_labels or not rankings:
+        return []
+    rows = []
+    for label in all_labels:
+        positions = [r.index(label) + 1 for r in rankings if label in r]
+        firsts = sum(1 for r in rankings if r and r[0] == label)
+        avg = sum(positions) / len(positions) if positions else float(len(all_labels) + 1)
+        rows.append((label, avg, firsts))
+    rows.sort(key=lambda row: (-row[2], row[1], row[0]))
+    return rows
+
+
+def _egress_messages(messages: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Redact every text part bound for a member/reviewer/judge (remote calls
+    that never needed the raw secret). Copies; the caller's transcript is untouched."""
+    out: list[dict[str, Any]] = []
+    for message in messages:
+        m = dict(message)
+        content = m.get("content")
+        if isinstance(content, str):
+            m["content"] = _redact_for_egress(content)
+        elif isinstance(content, list):
+            parts = []
+            for part in content:
+                if isinstance(part, dict) and isinstance(part.get("text"), str):
+                    part = {**part, "text": _redact_for_egress(part["text"])}
+                parts.append(part)
+            m["content"] = parts
+        out.append(m)
+    return out
+
+
+def _reported_model(response: Any) -> str | None:
+    model = getattr(response, "model", None)
+    return str(model) if model else None
+
+
