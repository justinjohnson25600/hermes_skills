+def test_first_place_votes_beat_average_rank():
+    from hermes_council.council_loop import aggregate_first_place, aggregate_rankings
+    labels = ["Response A", "Response B", "Response C"]
+    rankings = [["Response A", "Response C", "Response B"],
+                ["Response A", "Response C", "Response B"],
+                ["Response B", "Response C", "Response A"],
+                ["Response C", "Response B", "Response A"]]
+    # A: 2 firsts, avg 2.0; C: 1 first, avg 2.0 → first-place decides.
+    assert aggregate_first_place(rankings, labels)[0][0] == "Response A"
+    tie = [["Response A", "Response B"], ["Response B", "Response A"], ["Response A", "Response B"],
+           ["Response B", "Response A"]]
+    rows = aggregate_first_place(tie, ["Response A", "Response B"])
+    assert rows[0][2] == rows[1][2] == 2  # equal firsts → average rank tie-break, then label
+    # Self-exclusion: a label reviewers were not shown is NOT charged worst+1.
+    partial = [["Response B", "Response C"], ["Response A", "Response C"], ["Response A", "Response B"]]
+    rows = {r[0]: r for r in aggregate_first_place(partial, labels)}
+    assert rows["Response A"][1] == 1.0
+    assert aggregate_rankings  # compact aggregator still exported
+
